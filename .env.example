# Серверный URL NestJS-сервиса viber-bot. Не выносить в NEXT_PUBLIC_*.
# Локально: http://127.0.0.1:3001
# VM в GCP: http://<EXTERNAL_IP>:3001 или https://api.example.com[/префикс] за nginx.
# Логин и пароль basic auth можно указать прямо в URL: https://user:pass@api.example.com
VIBER_PARSER_URL=http://127.0.0.1:3001

# Необязательно: токен, который прокси отправляет как Authorization: Bearer <token>.
# Нужен, если бэкенд на VM закрыт reverse proxy с проверкой токена.
VIBER_PARSER_TOKEN=
