# Server-only URL of the Viber-parser REST service. Do not expose it via NEXT_PUBLIC_*.
VIBER_PARSER_URL=http://136.92.24.88:8080

# emulator-agent на VPS (по умолчанию — хост VIBER_PARSER_URL и порт 9000)
# EMULATOR_AGENT_URL=http://136.92.24.88:9000
# VPS_AGENT_SECRET=change-me

# scrcpy-web (экран эмуляторов). Панель проксирует его на /scrcpy/,
# чтобы экран открывался на HTTPS без блокировки Mixed Content.
# Если не задан — берётся хост EMULATOR_AGENT_URL / VIBER_PARSER_URL и порт 8000.
# В compose на GCP: http://host.docker.internal:8000 (см. docs/deploy-gcp.md).
SCRCPY_URL=http://136.92.24.88:8000
# Адрес scrcpy-web для прямой ссылки из браузера, если SCRCPY_URL внутренний.
# SCRCPY_PUBLIC_URL=http://136.92.24.88:8000

# Supabase Auth and Database
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
